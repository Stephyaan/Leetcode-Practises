def toBin(num):  #This converts decimal → binary.
  bin_num=""
  while num:
    rem=num%2
    bin_num+=str(rem)
    num//=2
  return int(bin_num[::-1]

def toggleBin(bin_num):  #toggles the binary no.
  bin_str=str(bin_num)
  toggle_bin=""
  for i in bin_str:
    if i=="0":
      toggle_bin+="1"
    else:
      toggle_bin+="0"
  return toggle_bin

