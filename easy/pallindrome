word=input("enter the word:")

def isPallin(word):
  i=0  #from start
  j=len(word)-1   #from end

  while i<=j:
    if word[i]!=word[j]:
      return False

    i+=1
    j-=1

if isPallin(word):
  return ("Pallindrome")
else:
  return ("Not Pallindrome")
