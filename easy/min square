import math
N=int(input("Enter the number:"))

def minSq(N):
  #initial worst case
  dp=[float('inf')]* (N+1)  #assume float no. infinity for N time initially
  dp[0]=0   #set initial starting point

  for i in range(1,N+1):
    j=1
    while j*j<=i:
      dp[i]=min(dp[i],dp[i-j*j]+1)
      j+=1
  print(dp)
  return dp[N]

