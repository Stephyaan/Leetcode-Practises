#easiest
def rle(s):
    result = ""
    count = 1

    for i in range(1, len(s)):
        if s[i] == s[i-1]:
            count += 1
        else:
            #count+the digit
            result += str(count) + s[i-1]
            count = 1 #1 since now it's new digit;start again

    #Last digit count
        result += str(count) + s[-1]

    return result

n = int(input("enter the number:"))
res = "1"
for i in range(n-1):
    res = rle(res)
