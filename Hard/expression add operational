def addOperators(num, target):

    result = []

    def backtrack(index, expression, value, previous):

        # All digits have been used
        if index == len(num):
            if value == target:
                result.append(expression)
            return

        # Try different lengths of the next number
        for i in range(index, len(num)):

            # Don't allow numbers like 05 or 012
            if i > index and num[index] == '0':
                break

            current_string = num[index:i + 1]
            current = int(current_string)

            # First number
            if index == 0:
                backtrack(
                    i + 1,
                    current_string,
                    current,
                    current
                )

            else:
                # +
                backtrack(
                    i + 1,
                    expression + "+" + current_string,
                    value + current,
                    current
                )

                # -
                backtrack(
                    i + 1,
                    expression + "-" + current_string,
                    value - current,
                    -current
                )

                # *
                backtrack(
                    i + 1,
                    expression + "*" + current_string,
                    value - previous + previous * current,
                    previous * current
                )

    backtrack(0, "", 0, 0)

    return result
