    if grid[nr][nc]=="R":
      return False

  #park adj to road or park
  if building=="P":
    found=False #look frwd for park or road adjacent
    
    for nr,nc in nearby:
      if grid[nr][nc]=="P" or grid[nr][nc]=='-':
        return True

    if not found:  
      return False
  
  return True

#parks min 1 adj road
def placement(grid,r,c,building):
  if valid_placement(grid,r,c,building):
    grid[r][c]=building
    return True
  
  return False
