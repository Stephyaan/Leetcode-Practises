#create grid
def create(n,m):
  return [['.' for _ in range(m)] for _ in range(n)]   #empty plots

#find neighbours adj
def neigh(grid,r,c):
  n=len(grid)  #row count
  m=len(grid[0])  #col count
  res=[]
  dir=[(0,1),(0,-1),(1,0),(-1,0)]   #adj positions
  for dr,dc in dir:
    nr=dr+r
    nc=dc+c
    if 0<=nr<n and 0<=nc<m:  #within no.of rows&cols
      res.append((nr,nc))
  return res

#cell must be empty
def valid_placement(grid,r,c,building):
  if grid[r][c] != '.':
    return False

  
  nearby=neighbours(grid,r,c)
  
  #R not adj to I
  if building=="R":
    for nr,nc in neighbours:
      if grid[nr][nc]=="I":
        return False

