parenthesis=input("enter the parenthesis string:")

def validPar(parenthesis):
  stack=[-1]
  count=0

  for i in parenthesis:
    if stack and i==')' and stack[-1]='(':  #pair found;then pop it and set count of pair to 2
      stack.pop()
      count+=2
    else:
      stack.append(i)

  return count

print(validPar(parenthesis))
      
