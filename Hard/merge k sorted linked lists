# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next

class Solution:    
    def mergeKLists(self, lists: List[Optional[ListNode]]) -> Optional[ListNode]:

      result=[]  #stores each values in list to single list
      for i in lists:
        result.append(i.val)
        i=i.next

      result.sort()
      
      #converting result list to listNode-linked list
      values=ListNode(0)
      cur=values

      for r in result:
        cur.next=ListNode(r)
        cur=cur.next

      return values.next
