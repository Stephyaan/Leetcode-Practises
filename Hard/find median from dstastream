import heapq

class MedianFinder:

    def __init__(self):
        self.left = []    # max heap
        self.right = []   # min heap

    def addNum(self, num):

        # Add to left
        heapq.heappush(self.left, -num)

        # Make sure every left value <= every right value
        if self.right and -self.left[0] > self.right[0]:
            value = -heapq.heappop(self.left)
            heapq.heappush(self.right, value)

        # Keep the two halves balanced
        if len(self.left) > len(self.right) + 1:
            value = -heapq.heappop(self.left)
            heapq.heappush(self.right, value)

        elif len(self.right) > len(self.left):
            value = heapq.heappop(self.right)
            heapq.heappush(self.left, -value)

    def findMedian(self):

        if len(self.left) > len(self.right):
            return -self.left[0]

        else:
            return (-self.left[0] + self.right[0]) / 2
