#For the left side: We need the smallest n numbers.Min firstSum. Use a max heap. (neg of min heap)
#right side: we need largest n numbers. Max secondSum. use min heap.
#answer : left[i]-right[i+1], and take the min of this
#by using heap, we encounter a no. and this is larger/smaller than in alrdy, need to replace and can replace directly.

import heapq

class Solution:
    def minimumDifference(self, nums):

    n=len(nums)//3   #len of nums is 3*n

    #left part -> first sum -> min -> maxHeap
    left=[0]*len(nums)

    heap=[]
    total=0

    for i in range(n):   # First n elements
      heapq.heappush(heap,-nums[i]) 
      total+=nums[i]

    left[n-1]=total

    for i in range(n,2*n):     # Process remaining left side
      heapq.heappush(heap,-nums[i])
      total+=nums[i]

      largest=-heapq.heappop(heap)   # Remove the largest selected value
      total-=largest

      left[i]=total

    #right part -> secondSum -> max -> minHeap
    right=[0]*len(nums)

    heap=[]
    total=0

    for i in range(2*n,3*n):  # Last n elements
      heapq.heappush(heap,nums[i])
      total+=nums[i]

    right[2*n]=total

    for i in range(2*n-1,n-1,-1):  # Process from right to left
      heapq.heappush(heap,nums[i])
      total+=nums[i]

      smallest=heapq.heappop(heap)  # Remove the smallest selected value
      total-=smallest

      right[i]=total

  #find min difference
  answer=float('inf')

  for i in range(n-1,2*n):
    answer=min(answer,left[i]-right[i+1])

  return answer
