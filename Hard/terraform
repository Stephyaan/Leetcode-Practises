def terr(M,H,G):
  if M==1:
    if H[0]==M[0]:
      return 0
    else:
      return -1
  explosions=H[0]-G[0]
  if explosions<0:
    return -1
  total=explosions
  for i in range(1,M):
    current=H[i]-G[i]-explosions
    if current<0:
      return -1
    explosions=current
    total+=explosions
  if explosions!=H[M-1]-G[M-1]:
    return -1
  return total
